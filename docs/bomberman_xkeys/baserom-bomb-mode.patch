+
+	LDA.l $7FFC00, X : STA.w $0D10, Y
+	LDA.l $7FFC80, X : STA.w $0D30, Y
+	LDA.l $7FFD00, X : STA.w $0D00, Y
+	LDA.l $7FFD80, X : STA.w $0D20, Y
+	LDA.b #$01 : STA.w $09D0, Y
+
+	TYX
+	STZ.w $0F60, X
