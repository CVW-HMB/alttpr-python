+	LDA.w #$F859 : STA.b $04
+	RTL
+.specialSword
+	LDA.l SpecialWeaponLevel : AND.w #$00FF : STA.b $02
+	LDA.w #$FC51 : STA.b $04
+	RTL
+;--------------------------------------------------------------------------------
+DrawBombInYBox:
+	CPX.w #$0004 : BNE .done
+	LDA.l SpecialWeapons : AND.w #$007F : CMP.w #$0001 : BNE .vanilla
+	LDA.l SpecialWeaponLevel : AND.w #$00FF : CLC : ADC.w #$00BD : BRA .done
+.vanilla
